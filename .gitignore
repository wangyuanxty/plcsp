# ── 外部资源：体积 + 版权 + 嵌套 .git（33 个克隆各有自己的 .git）──
third_party/
references/
checkpoints/

# ── JobShopLab 试跑（第三方框架 + 它的 venv；用户要求落项目**根目录**）──
# 前导 `/` 锚到仓库根，不会误伤同名子目录。见 progress-log §66。
/jobshoplab/
/jobshoplab-venv/

# ── 生成物 ──
plcsp/figs/
__pycache__/
*.pyc
*.pyo

# ── LaTeX 编译产物（源文件入库，中间产物不入库）──
# `paper/*.pdf` 只匹配 paper/ 直属层，figures/ 里的矢量图不受影响，必须入库
paper/*.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.spl
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.bcf
paper/*.run.xml

# ── 运行日志（可重生成）──
*_run.log
*_run*.log

# ── superpowers skill 工作区（ledger / brief / review 包，git-ignored scratch）──
.superpowers/

# ── Claude Code：提交项目共享配置，忽略机器本地配置 ──
.claude/settings.local.json

# ── 编辑器/系统 ──
.vscode/
.idea/
Thumbs.db
desktop.ini
