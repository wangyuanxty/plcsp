{
  "max_parallel": 6,
  "min_free_gb": 3.0,
  "poll_seconds": 20,
  "stop_on_failure": false,
  "jobs": [
    {
      "id": "gen_J10M6E2",
      "script": "gen_dataset.py",
      "priority": 1,
      "notes": "Generate J10M6E2 train/eval/test pkls, seed 1/1/3",
      "args": [
        "--n_job",
        "10",
        "--n_machine",
        "6",
        "--n_edge",
        "2",
        "--train_seed",
        "1",
        "--eval_seed",
        "1",
        "--test_seed",
        "3"
