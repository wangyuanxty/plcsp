    },
    {
      "id": "E4b_main",
      "script": "Run.py",
      "priority": 10,
      "notes": "Main model: RS on + JA/MA/AA all ST + global ST critic + AGV actor",
      "args": [
        "--encoder_type",
        "settrans",
        "--st_token_context",
        "1",
        "--st_task_features",
        "1",
        "--st_edge_features",
        "0",
        "--random_weight_type",
        "01",
        "--algo",
        "ppo",
        "--hier",
        "1",
        "--hier_interval",
        "8",
        "--hier_alpha",
        "1.0",
        "--use_agv",
        "1",
        "--n_agv",
        "6",
        "--cross_delay",
        "5",
        "--cross_leg_ratio",
        "0.5",
        "--episode_num",
        "200",
        "--LR",
        "1e-3",
        "--use_lr_decay",
        "0",
        "--eval_sample",
        "100",
        "--run_tag",
        "settrans_ctx_taskf_randw_lr1e3_hier_agv_200_remote"
      ]
    },
    {
